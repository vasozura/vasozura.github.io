{
  "name": "zura-composer-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-performance-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:secrets": "node scripts/check-no-secrets.mjs",
    "import:song": "tsx scripts/import-song.ts",
    "import:song:dry-run": "tsx scripts/import-song.ts --dry-run",
    "import:batch": "tsx scripts/import-batch.ts",
    "import:batch:dry-run": "tsx scripts/import-batch.ts --dry-run",
    "prepare:phase6": "tsx scripts/prepare-phase6-suno-packages.ts",
    "prepare:vocal": "tsx scripts/prepare-vocal-learning.ts",
    "verify:karaoke": "tsx scripts/verify-karaoke-render.ts",
    "realign:karaoke": "tsx scripts/realign-karaoke.ts",
    "verify:karaoke:sync": "tsx scripts/verify-karaoke-sync.ts",
    "verify:karaoke:browser": "tsx scripts/verify-karaoke-browser.ts",
    "publish:karaoke": "tsx scripts/publish-karaoke-artifacts.ts",
    "publish:karaoke:dry-run": "tsx scripts/publish-karaoke-artifacts.ts --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tonejs/midi": "^2.0.28",
    "opensheetmusicdisplay": "^2.1.2"
  }
}
